[Unit]
Description=Retell Call Agent Backend
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/path/to/retell_call_agent/app
Environment=PATH=/path/to/retell_call_agent/venv/bin:/usr/bin:/bin
ExecStart=/path/to/retell_call_agent/venv/bin/uvicorn main_new:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
