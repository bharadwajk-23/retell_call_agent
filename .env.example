# Single .env for the whole project. Copy this to .env and fill in real
# values. Backend (via pydantic-settings), frontend (via Vite's envDir),
# and docker-compose all read the one file — there is no per-service .env.

# --- Backend runtime ---
ENV=development
HOST=0.0.0.0
PORT=8006
LOG_LEVEL=INFO

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:8005

# --- Retell AI ---
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_AGENT_ID_Backup=
# Telnyx/Twilio number provisioned in the Retell dashboard, E.164 format
RETELL_FROM_NUMBER=
# true = skip the real Retell API call (returns a fake call id) for local/demo use
RETELL_MOCK_CALLS=false

# --- Reference data (optional overrides) ---
# PROVIDER_DETAILS_PATH=/absolute/path/to/provider_details.json

# --- Frontend ---
# API base URL: relative path for production (works behind reverse proxy), absolute for local dev
# Production: /janus/voice-agent/api (served through reverse proxy at /janus/voice-agent/api/*)
# Local: http://localhost:8006/api
VITE_API_BASE_URL=/janus/voice-agent/api
FRONTEND_PORT=8005

# --- docker-compose only: host-side port mapping for the backend container ---
BACKEND_PORT=8006
