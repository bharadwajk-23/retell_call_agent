# Root-level values consumed by docker-compose.yml.
#
# Backend secrets/config live in backend/.env (copy backend/.env.example).
# This file only controls host ports and the frontend's build-time API URL.

BACKEND_PORT=8000
FRONTEND_PORT=5173

# Must match backend's CORS_ORIGINS entry for the frontend's origin.
CORS_ORIGINS=http://localhost:5173

# Baked into the frontend bundle at build time (Vite env vars are static).
VITE_API_BASE_URL=http://localhost:8000/api
